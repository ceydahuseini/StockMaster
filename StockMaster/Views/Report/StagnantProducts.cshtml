@model List<StockMaster.ViewModels.StagnantProductViewModel>
@{ ViewData["Title"] = "Stagnant Products"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Stagnant Products (No Sales > 90 Days)</h2>
    <div>
        <a href="/Report/Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back</a>
        <a href="/Report/ExportStagnantProducts" class="btn btn-success"><i class="fas fa-file-csv"></i> CSV</a>
        <button onclick="exportToPDF()" class="btn btn-danger"><i class="fas fa-file-pdf"></i> PDF</button>
    </div>
</div>

<div id="reportContent">
    <table class="table table-bordered table-danger">
        <thead>
            <tr>
                <th>Product</th>
                <th>SKU</th>
                <th>Stock On Hand</th>
                <th>Last Sold</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model) {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Sku</td>
                <td>@item.QuantityOnHand</td>
                <td>@item.LastSoldDate</td>
            </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        function exportToPDF() {
            var element = document.getElementById('reportContent');
            var opt = {
                margin: 0.5, filename: 'StagnantProducts.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
}