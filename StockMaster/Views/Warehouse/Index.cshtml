@model List<StockMaster.Models.Warehouse>
@{
    ViewData["Title"] = "Warehouses";
}

<div class="row mb-4">
    <div class="col-md-6">
        <h2><i class="fas fa-warehouse"></i> Warehouse Management</h2>
    </div>
    <div class="col-md-6 text-end">
        <a href="/Warehouse/Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Warehouse
        </a>
    </div>
</div>

<div class="row g-4">
    @foreach (var warehouse in Model)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>
                        <i class="fas fa-building me-2"></i> @warehouse.Name
                    </span>
                    <div class="btn-group">
                        <a href="/Warehouse/Edit/@warehouse.WarehouseId" class="btn btn-sm btn-light text-dark" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-light text-danger" title="Delete" onclick="deleteWarehouse(@warehouse.WarehouseId)">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted d-block">Location</small>
                        <i class="fas fa-map-marker-alt me-1"></i> @warehouse.Location
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block">Capacity</small>
                        <i class="fas fa-box me-1"></i> @warehouse.Capacity.ToString("N0") units
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block">Created Date</small>
                        <i class="fas fa-calendar me-1"></i> @warehouse.CreatedAt.ToString("dd.MM.yyyy")
                    </div>

                    <a href="/Warehouse/Stock/@warehouse.WarehouseId" class="btn btn-primary w-100">
                        <i class="fas fa-cubes"></i> View Stock Status
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function deleteWarehouse(id) {
            if (confirm('Are you sure you want to delete this warehouse? This cannot be undone.')) {
                var form = document.getElementById('deleteForm');
                form.action = '/Warehouse/Delete/' + id;
                form.submit();
            }
        }
    </script>
}